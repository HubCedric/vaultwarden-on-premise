# Version active observée sur le slave : exécution quotidienne malgré le nom.
[Unit]
Description=Réconciliation hebdomadaire Vaultwarden

[Timer]
OnCalendar=*-*-* 04:15:00 Europe/Paris
RandomizedDelaySec=15min
Persistent=true
Unit=vaultwarden-weekly-reconcile.service

[Install]
WantedBy=timers.target

