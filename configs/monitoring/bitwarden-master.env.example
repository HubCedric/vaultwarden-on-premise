# Exemple commun — compléter localement, ne jamais commiter les secrets.
MONITOR_USER=vaultwarden_monitor
MONITOR_PASSWORD=<SECRET_MONITORING>
VAULTWARDEN_DB=vaultwarden
COUNT_TABLES="users ciphers folders folders_ciphers devices twofactor organizations users_organizations collections users_collections attachments sends"
VAULTWARDEN_CONTAINER=vaultwarden
CONTAINER_STARTING_MAX_SECONDS=120
RESTART_DELTA_CRITICAL=3
LAG_WARNING_SECONDS=60
LAG_CRITICAL_SECONDS=300
FAILURES_BEFORE_STOP=2
STATE_DIR=/var/lib/vaultwarden-monitor
LOG_FILE=<CHEMIN_LOG_MONITORING>
MAINTENANCE_FILE=/etc/vaultwarden-monitor/maintenance
MAIL_FROM=<ADRESSE_EXPEDITEUR>
MAIL_TO=<ADRESSE_DESTINATAIRE>
TIMEZONE=Europe/Paris
REMINDER_HOUR=9
RECONCILE_SCRIPT=/opt/reconcile_split_brain.sh
RECONCILE_OUTPUT_DIR=/var/lib/vaultwarden-monitor/reconcile
RECONCILE_CONFIRMATION_DELAY_SECONDS=300

NODE_NAME=bitwarden-master
NODE_ROLE=master
LOCAL_DB_HOST=10.0.0.1
LOCAL_DB_PORT=3306
LOCAL_SERVER_ID=1
PEER_NAME=bitwarden-slave
PEER_HOST=10.0.0.2
PEER_PORT=3306
PEER_SERVER_ID=2
EXPECTED_MASTER_HOST=10.0.0.2
EXPECTED_MASTER_PORT=3306
EXPECTED_GTID_MODE=Slave_Pos
ALLOW_SAFETY_STOP=0
