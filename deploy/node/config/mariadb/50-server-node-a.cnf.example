[mariadb]
server_id=1
log_bin=mysql-bin-a
binlog_format=ROW
log_slave_updates=ON
gtid_strict_mode=ON
skip_name_resolve=ON
bind_address=0.0.0.0

# Reduce collision risk for tables using AUTO_INCREMENT.
auto_increment_increment=2
auto_increment_offset=1

# Keep enough binlogs to survive a temporary outage.
binlog_expire_logs_seconds=604800
max_binlog_size=100M
