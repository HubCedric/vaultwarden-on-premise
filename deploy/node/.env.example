# Identity
COMPOSE_PROJECT_NAME=vaultwarden-a
TZ=Europe/Paris
WIREGUARD_IP=10.0.0.1

# Images: use explicit, tested versions on both nodes
VAULTWARDEN_VERSION=1.36.0
MARIADB_VERSION=11.4

# Public URL
DOMAIN=https://vault.example.net

# MariaDB bootstrap values
MARIADB_DATABASE=vaultwarden
MARIADB_USER=vaultwarden
MARIADB_PASSWORD=CHANGE_ME_APPLICATION_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Vaultwarden uses the internal Compose service name "mariadb".
# URL-encode reserved characters in the password.
DATABASE_URL=mysql://vaultwarden:CHANGE_ME_APPLICATION_PASSWORD@mariadb:3306/vaultwarden

# Generate an Argon2 PHC hash using the current Vaultwarden documentation.
# Keep the whole value single-quoted. Depending on the Compose version, literal
# dollar signs may need to be doubled; always inspect the resolved value with
# `docker compose --env-file .env config` before the first deployment.
ADMIN_TOKEN='CHANGE_ME_ARGON2_HASH'

SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false
LOG_LEVEL=warn
EXTENDED_LOGGING=true
