# Copier ce fichier en ".env" (non commité) dans le même dossier que les
# scripts, et renseigner les vraies valeurs. Un seul fichier, partagé par
# les 3 scripts (update_vaultwarden.sh, check_replication.sh,
# reconcile_split_brain.sh) — chacun ne lit que les variables qui le
# concernent, ignore les autres.
#
# À dupliquer sur srv1 ET srv2, avec des valeurs adaptées à chacun (NODE_NAME,
# et l'inversion LOCAL/PEER ou MASTER/SLAVE selon le serveur notamment).
#
# Tous les identifiants (utilisateur et mot de passe) valent "<change-me>"
# ci-dessous : à remplacer par les vraies valeurs, jamais commité tel quel.

# =============================================================================
# update_vaultwarden.sh
# =============================================================================

# Chemin absolu du dossier contenant le docker-compose.yml de Vaultwarden
COMPOSE_DIR="/opt/vaultwarden"

# Nom du service/conteneur Vaultwarden dans le docker-compose.yml
CONTAINER_NAME="vaultwarden"

# Connexion à la base MariaDB/MySQL locale (compte applicatif Vaultwarden,
# déjà ALL PRIVILEGES sur sa propre base)
DB_HOST="127.0.0.1"
DB_NAME="vaultwarden"
DB_USER="<change-me>"
DB_PASSWORD="<change-me>"

# Dossier où stocker les dumps de backup
BACKUP_DIR="/opt/vaultwarden/backups"

# Nombre de jours de rétention des backups avant purge automatique
BACKUP_RETENTION_DAYS=14

# Fichier de log de update_vaultwarden.sh
UPDATE_LOG_FILE="/var/log/update_vaultwarden.log"

# Timeout (en secondes) d'attente du healthcheck après la mise à jour.
# À augmenter (ex: 300) si la base contient beaucoup de lignes : certaines
# migrations Vaultwarden traitent les données ligne par ligne au démarrage,
# et le serveur web ne répond healthy qu'une fois les migrations terminées.
HEALTHCHECK_TIMEOUT=300

# =============================================================================
# check_replication.sh (voir README, section "Surveillance et correction
# automatique de la réplication" pour la création du compte monitor)
# =============================================================================

# Nom de ce nœud, utilisé uniquement pour identifier la machine dans les
# logs et les emails d'alerte (ex: "bitwarden-master" sur srv1).
NODE_NAME="srv1"

# Utilisateur de supervision : mêmes identifiants sur les 2 nœuds, mais
# privilèges différents selon l'hôte de connexion ('monitor'@'localhost' et
# 'monitor'@'127.0.0.1' ont SUPER, 'monitor'@'<IP pair>' n'a que
# REPLICATION CLIENT).
MONITOR_USER="<change-me>"
MONITOR_PASSWORD="<change-me>"

# IP VPN et port du serveur MariaDB pair (ex: srv2 si ce fichier est sur srv1)
PEER_HOST="10.0.0.2"
PEER_PORT=3306

# Identifiants de réplication (mêmes que ceux utilisés lors du CHANGE MASTER
# TO initial documenté dans le README) — nécessaires si le script doit
# reconfigurer lui-même la réplication après une perte de configuration.
REPL_USER="<change-me>"
REPL_PASSWORD="<change-me>"

# Retard (en secondes) au-delà duquel un retard de réplication est signalé,
# même si les threads IO/SQL tournent normalement.
SECONDS_BEHIND_THRESHOLD=60

# Nombre de tentatives de redémarrage (STOP SLAVE puis START SLAVE) en cas
# de thread arrêté sans erreur de données, et délai (en secondes) entre
# chaque tentative avant de revérifier le statut.
RESTART_RETRY_COUNT=3
RESTART_RETRY_DELAY=10

# Envoi d'email d'alerte : 0 = désactivé (les alertes ne vont que dans
# REPLICATION_LOG_FILE), 1 = activé (nécessite un MTA local fonctionnel :
# postfix, ssmtp, msmtp...). Désactivé par défaut pour le moment.
ENABLE_MAIL=0
MAIL_TO="admin@example.com"

# Fichier de log de check_replication.sh
REPLICATION_LOG_FILE="/var/log/check_replication.log"

# =============================================================================
# reconcile_split_brain.sh (outil PONCTUEL, pas de cron — voir README,
# section "Récupération après une réplication cassée durablement")
# =============================================================================

# Connexion en lecture seule (compte dédié 'reconcile_ro', voir README —
# jamais 'vaultwarden' ni 'monitor') vers le serveur désigné comme "master"
# dans ce dossier. Mettre 127.0.0.1 pour le côté LOCAL (celui d'où tourne le
# script), l'IP VPN réelle pour le côté distant.
MASTER_HOST="10.0.0.1"
MASTER_PORT=3306
MASTER_USER="<change-me>"
MASTER_PASSWORD="<change-me>"

# Idem vers le serveur désigné comme "slave".
SLAVE_HOST="10.0.0.2"
SLAVE_PORT=3306
SLAVE_USER="<change-me>"
SLAVE_PASSWORD="<change-me>"

# Connexion locale utilisée UNIQUEMENT pour héberger les bases temporaires
# de comparaison sur la machine où tourne ce script (droits CREATE/DROP
# DATABASE nécessaires — ex: root via socket, comme "sudo mysql -u root").
LOCAL_ADMIN_USER="<change-me>"
LOCAL_ADMIN_SOCKET=""

# Utilisés UNIQUEMENT avec --apply, pour écrire réellement sur le serveur
# DISTANT (celui dont le *_HOST ci-dessus n'est pas 127.0.0.1/localhost).
# C'est le compte applicatif Vaultwarden existant (même compte que
# DB_USER/DB_PASSWORD ci-dessus, mais celui de l'AUTRE serveur — déjà ALL
# PRIVILEGES sur vaultwarden.*, déjà joignable via le réseau VPN, aucun
# nouveau compte à créer). Ignorés si --apply n'est pas utilisé.
MASTER_WRITE_USER="<change-me>"
MASTER_WRITE_PASSWORD="<change-me>"
SLAVE_WRITE_USER="<change-me>"
SLAVE_WRITE_PASSWORD="<change-me>"
