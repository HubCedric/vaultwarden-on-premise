# Copier ce fichier en ".env" (non commité) dans le même dossier que le script,
# et renseigner les vraies valeurs.

# Chemin absolu du dossier contenant le docker-compose.yml de Vaultwarden
COMPOSE_DIR="/opt/vaultwarden"

# Nom du service/conteneur Vaultwarden dans le docker-compose.yml
CONTAINER_NAME="vaultwarden"

# Identifiants de connexion à la base MariaDB/MySQL
DB_HOST="127.0.0.1"
DB_NAME="vaultwarden"
DB_USER="vaultwarden"
DB_PASSWORD="change-me"

# Dossier où stocker les dumps de backup
BACKUP_DIR="/opt/vaultwarden/backups"

# Nombre de jours de rétention des backups avant purge automatique
BACKUP_RETENTION_DAYS=14

# Fichier de log du script
LOG_FILE="/var/log/update_vaultwarden.log"

# Timeout (en secondes) d'attente du healthcheck après la mise à jour.
# À augmenter (ex: 300) si la base contient beaucoup de lignes : certaines
# migrations Vaultwarden traitent les données ligne par ligne au démarrage,
# et le serveur web ne répond healthy qu'une fois les migrations terminées.
HEALTHCHECK_TIMEOUT=300
