# Shared script configuration. Copy to scripts/.env and chmod 600.

# Deployment paths
DEPLOY_DIR=/opt/vaultwarden-on-premise/deploy/node
DEPLOY_ENV_FILE=/opt/vaultwarden-on-premise/deploy/node/.env
COMPOSE_FILE=/opt/vaultwarden-on-premise/deploy/node/compose.yaml
VAULTWARDEN_SERVICE=vaultwarden
VAULTWARDEN_DATA_DIR=/opt/vaultwarden-on-premise/deploy/node/data/vaultwarden

# Logs
BACKUP_LOG_FILE=/var/log/vaultwarden-backup.log
UPDATE_LOG_FILE=/var/log/vaultwarden-update.log
REPLICATION_LOG_FILE=/var/log/vaultwarden-replication.log
HEALTHCHECK_LOG_FILE=/var/log/vaultwarden-healthcheck.log

# Backup
BACKUP_DIR=/var/backups/vaultwarden
BACKUP_RETENTION_DAYS=14

# Database access from the host. Use the local WireGuard IP because Compose
# publishes 3306 on that address.
DB_HOST=10.0.0.1
DB_PORT=3306
DB_NAME=vaultwarden
DB_USER=vaultwarden
DB_PASSWORD=CHANGE_ME_APPLICATION_PASSWORD

# Update behaviour
HEALTHCHECK_TIMEOUT=300

# Replication monitoring
NODE_NAME=node-a
LOCAL_DB_HOST=10.0.0.1
LOCAL_DB_PORT=3306
PEER_HOST=10.0.0.2
PEER_PORT=3306
MONITOR_USER=monitor
MONITOR_PASSWORD=CHANGE_ME_MONITOR_PASSWORD
REPL_USER=repl
REPL_PASSWORD=CHANGE_ME_REPLICATION_PASSWORD
SECONDS_BEHIND_THRESHOLD=60
REPLICATION_AUTO_RESTART=1
REPLICATION_AUTO_RECONFIGURE=0
RESTART_RETRY_COUNT=3
RESTART_RETRY_DELAY=10

# Optional email alerts. Requires a working local `mail` command/MTA.
ENABLE_MAIL=0
MAIL_TO=admin@example.net
