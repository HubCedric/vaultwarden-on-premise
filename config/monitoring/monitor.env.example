# Copier vers /etc/vaultwarden-monitor/monitor.env puis chmod 600.
# Adapter ce fichier différemment sur chaque nœud.

# Identité locale
NODE_NAME="bitwarden-master"
NODE_ROLE="master"                     # master ou slave
LOCAL_DB_HOST="127.0.0.1"
LOCAL_DB_PORT="3306"
LOCAL_SERVER_ID="1"

# Pair attendu
PEER_NAME="bitwarden-slave"
PEER_HOST="10.0.0.2"
PEER_PORT="3306"
PEER_SERVER_ID="2"

# Compte MariaDB de supervision (lecture seule)
MONITOR_USER="vaultwarden_monitor"
MONITOR_PASSWORD="A_CONFIGURER"

# Réplication
EXPECTED_MASTER_HOST="10.0.0.2"
EXPECTED_MASTER_PORT="3306"
EXPECTED_GTID_MODE="Slave_Pos"
LAG_WARNING_SECONDS="60"
LAG_CRITICAL_SECONDS="300"
FAILURES_BEFORE_STOP="2"

# Conteneur Vaultwarden
VAULTWARDEN_CONTAINER="vaultwarden"
CONTAINER_STARTING_MAX_SECONDS="120"
RESTART_DELTA_CRITICAL="3"

# Arrêt de sécurité. 1 uniquement sur bitwarden-slave.
ALLOW_SAFETY_STOP="0"

# SMTP via msmtp
MSMTP_ACCOUNT="vaultwarden-monitor"
MAIL_FROM="no-reply@example.net"
MAIL_TO="admin@example.net"
MAIL_FROM_NAME="Vaultwarden Monitoring"
MAIL_ENABLED="1"

# Rappel quotidien des incidents persistants
REMINDER_HOUR="9"
TIMEZONE="Europe/Paris"

# Chemins
STATE_DIR="/var/lib/vaultwarden-monitor"
LOG_FILE="/var/log/vaultwarden-replication-monitor.log"
MAINTENANCE_FILE="/etc/vaultwarden-monitor/maintenance"

# Cohérence quotidienne
VAULTWARDEN_DB="vaultwarden"
COUNT_TABLES="users ciphers folders folders_ciphers devices twofactor organizations users_organizations collections users_collections attachments sends"

# Réconciliation hebdomadaire
RECONCILE_SCRIPT="/opt/reconcile_split_brain.sh"
RECONCILE_OUTPUT_DIR="/var/lib/vaultwarden-monitor/reconcile"
