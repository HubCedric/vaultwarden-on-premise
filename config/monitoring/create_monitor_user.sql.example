-- Exécuter sur CHAQUE serveur MariaDB.
-- Remplacer le mot de passe et ajuster les hôtes autorisés si nécessaire.
-- MariaDB 10.5.9+ : REPLICA MONITOR est le droit dédié pour SHOW SLAVE/REPLICA STATUS.

CREATE USER IF NOT EXISTS 'vaultwarden_monitor'@'127.0.0.1'
  IDENTIFIED BY 'A_CONFIGURER';
CREATE USER IF NOT EXISTS 'vaultwarden_monitor'@'10.0.0.%'
  IDENTIFIED BY 'A_CONFIGURER';

GRANT REPLICA MONITOR ON *.* TO 'vaultwarden_monitor'@'127.0.0.1';
GRANT REPLICA MONITOR ON *.* TO 'vaultwarden_monitor'@'10.0.0.%';

GRANT SELECT ON vaultwarden.* TO 'vaultwarden_monitor'@'127.0.0.1';
GRANT SELECT ON vaultwarden.* TO 'vaultwarden_monitor'@'10.0.0.%';

FLUSH PRIVILEGES;
