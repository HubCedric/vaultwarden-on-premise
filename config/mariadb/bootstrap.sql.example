-- Run after replacing every CHANGE_ME value.
-- Execute on both nodes, adapting the peer IP.

CREATE DATABASE IF NOT EXISTS vaultwarden
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

CREATE USER IF NOT EXISTS 'vaultwarden'@'%' IDENTIFIED BY 'CHANGE_ME_APP_PASSWORD';
GRANT ALL PRIVILEGES ON vaultwarden.* TO 'vaultwarden'@'%';

-- On node A, restrict this account to 10.0.0.2.
-- On node B, restrict this account to 10.0.0.1.
CREATE USER IF NOT EXISTS 'repl'@'CHANGE_ME_PEER_WIREGUARD_IP' IDENTIFIED BY 'CHANGE_ME_REPLICATION_PASSWORD';
GRANT REPLICATION SLAVE ON *.* TO 'repl'@'CHANGE_ME_PEER_WIREGUARD_IP';

-- Local monitor may restart threads when explicitly enabled.
CREATE USER IF NOT EXISTS 'monitor'@'localhost' IDENTIFIED BY 'CHANGE_ME_MONITOR_PASSWORD';
GRANT REPLICATION CLIENT, REPLICATION SLAVE ADMIN ON *.* TO 'monitor'@'localhost';

CREATE USER IF NOT EXISTS 'monitor'@'127.0.0.1' IDENTIFIED BY 'CHANGE_ME_MONITOR_PASSWORD';
GRANT REPLICATION CLIENT, REPLICATION SLAVE ADMIN ON *.* TO 'monitor'@'127.0.0.1';

-- Host-side scripts reaching the published Docker port are normally seen as
-- the fixed Compose gateway configured in deploy/node/compose.yaml.
CREATE USER IF NOT EXISTS 'monitor'@'172.30.10.1' IDENTIFIED BY 'CHANGE_ME_MONITOR_PASSWORD';
GRANT REPLICATION CLIENT, REPLICATION SLAVE ADMIN ON *.* TO 'monitor'@'172.30.10.1';

-- Remote monitor can only read replication status.
CREATE USER IF NOT EXISTS 'monitor'@'CHANGE_ME_PEER_WIREGUARD_IP' IDENTIFIED BY 'CHANGE_ME_MONITOR_PASSWORD';
GRANT REPLICATION CLIENT ON *.* TO 'monitor'@'CHANGE_ME_PEER_WIREGUARD_IP';

FLUSH PRIVILEGES;
